# /etc/bsi-post/config.env   (root:bsipost, mode 640)
# Tokens are NOT kept here: store them with  bsi-post set-token instagram|facebook

# Graph API version to call, e.g. v24.0. Confirm the current version at setup.
GRAPH_VERSION=

# Who may approve a weekly batch: the exact name written in batch.json
# approval.approved_by (internal record, visible on GitHub; the public credit
# on each post is the subject-matter expert). Comma-separated if more than one.
APPROVERS=Yashodhan Bhawe

# Instagram professional account ID and Facebook Page ID (from Meta at setup).
IG_USER_ID=
FB_PAGE_ID=

# graph.instagram.com = Instagram API with Instagram Login (token lasts 60 days,
#                       refreshed automatically every IG_REFRESH_DAYS).
#                       IMAGES ONLY: Meta allows resumable video upload (reels,
#                       video stories) only with Facebook Login.
# graph.facebook.com  = Instagram API with Facebook Login. Instagram calls use
#                       the Facebook token unless an instagram token is set.
IG_HOST=graph.facebook.com

# 0 = do everything except call Meta (log what would post). 1 = post.
LIVE=0
# Turn platforms on one at a time if wanted.
ENABLED_PLATFORMS=instagram,facebook

# Pacing. Defaults shown.
MAX_POSTS_PER_RUN=2
POST_GAP_SEC=120
CALL_GAP_SEC=3
POLL_EVERY_SEC=30
POLL_MAX_MIN=15
MISSED_AFTER_MIN=360
IG_REFRESH_DAYS=20

# Email alerts (HALT, failed, needs_check, missed, skipped batches). One digest
# per run, each problem reported once, at most ALERTS_PER_DAY emails a day.
# Leave ALERT_TO empty to turn alerts off. SMTP password: bsi-post set-token smtp
ALERT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
ALERTS_PER_DAY=6

SITE_URL=https://www.berg-schmidt.co.in
REPO_URL=https://github.com/yash008-VHPL/bs-india-website.git
DATA_DIR=/var/lib/bsi-post
